# =============================================================================
# AWS CDK Infrastructure Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# Project Configuration
PROJECT_NAME=MyProject

# AWS Configuration
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# Environment (dev, staging, production)
ENV=dev

# Optional: AWS Profile for local development
# AWS_PROFILE=default

# =============================================================================
# Stack-Specific Configuration (Optional)
# =============================================================================

# S3 Configuration
# S3_EXPIRATION_DAYS=1

# Cognito Configuration
# COGNITO_DOMAIN_PREFIX=myproject

# API Gateway Configuration
# API_THROTTLE_RATE=1000
# API_THROTTLE_BURST=2000
